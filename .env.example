# Database
POSTGRES_USER=hcm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hcm
DATABASE_URL=postgresql+psycopg://hcm:change_me@db:5432/hcm

# Auth
JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_HOURS=8

# Optional first-run admin (otherwise created from the setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI (backend only, never in frontend)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20

# Frontend
NEXT_PUBLIC_API_URL=/api

# AI module: backend only; load explicitly in your backend deployment.
# AI_API_KEY and AI_MODEL above remain legacy aliases for the selected provider.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEZONE=Asia/Karachi

# Optional local-only playground. Production never imports its entry point.
AI_PLAYGROUND=0
# Optional: AI_PLAYGROUND_ENV_FILE=/absolute/path/to/.env
