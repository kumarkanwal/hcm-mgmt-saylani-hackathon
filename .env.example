# Database
POSTGRES_USER=hcm_lite_app
POSTGRES_PASSWORD=replace_with_a_generated_secret
POSTGRES_DB=hcm_lite
DATABASE_URL=postgresql+psycopg://hcm_lite_app:replace_with_a_generated_secret@db:5432/hcm_lite

# Auth
JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_HOURS=8

# Optional first-run admin (otherwise created from the setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI (backend only, never in frontend)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20

# Frontend
NEXT_PUBLIC_API_URL=/api
